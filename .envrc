#!/usr/bin/env bash
# 本地开发环境：使用 uv 管理 .venv
#
# 为什么不用 layout_poetry：
#   本机没有 Poetry，且构建原发布产物所用的 CPython 3.11.9 已不存在，
#   `poetry env info --path` 失败会让 direnv 直接 exit 2，激活中断。
#
# 为什么不用 `uv lock`/`uv sync`：
#   本项目依赖声明在 [tool.poetry.dependencies]，而 uv 需要 PEP-621 [project] 才能
#   生成 lock。实测 uv 的 dynamic = ["dependencies"] 并不会读取 Poetry 表（解析结果为空），
#   因此要生成 uv.lock 就必须把依赖清单复制成两份。为保持 Poetry 为唯一数据源，
#   这里改用 tools/uv_deps.py 从 pyproject.toml 直接推导依赖规格。
#
# 注意：uv 的缓存目录必须显式指定。默认的 ~/.cache/uv 不可写时 uv 会直接硬失败
#（"Failed to initialize cache"），而不是退回其它位置。

export UV_CACHE_DIR="${UV_CACHE_DIR:-$PWD/.uv-cache}"
export UV_PYTHON="${UV_PYTHON:-3.11.15}"

# slimeface 只发布了 macOS x86_64 轮子，没有 arm64 版本；退化为源码构建时，
# 其 sdist 又缺少 libfacedetection 子模块，因此在 Apple Silicon 上装不上。
# javsp/cropper/slimeface_crop.py 有 try/except 兜底到 DefaultCropper，
# 且 config.yml 默认 crop.engine: null（未启用裁剪），故排除它不影响主流程。
# 默认值由平台决定，这样 direnv 激活无需外部环境变量即可成功。
case "${UV_EXCLUDE_PACKAGES:-}" in
  "")  # 未显式设置时按平台给默认值
    if [[ "$(uname -s)" == "Darwin" && "$(uname -m)" == "arm64" ]]; then
      UV_EXCLUDE_PACKAGES="slimeface"
    else
      UV_EXCLUDE_PACKAGES=""
    fi ;;
esac
export UV_EXCLUDE_PACKAGES

if [[ ! -d .venv ]]; then
  log_status "未找到 .venv，正在用 uv 创建（Python ${UV_PYTHON}）..."
  uv venv --python "$UV_PYTHON" .venv >/dev/null
fi

# 以 pyproject.toml 的 mtime 作为依赖是否变化的标记
_stamp="$PWD/.venv/.deps-stamp"
if [[ ! -f "$_stamp" || pyproject.toml -nt "$_stamp" ]]; then
  log_status "正在同步依赖（依据 pyproject.toml）..."
  _args=()
  for _pkg in $UV_EXCLUDE_PACKAGES; do
    _args+=(--exclude "$_pkg")
  done
  # 注意：macOS 自带 bash 3.2，没有 mapfile/readarray，这里用 while read 逐行收集
  _deps=()
  while IFS= read -r _line; do
    [[ -n "$_line" ]] && _deps+=("$_line")
  done < <(python3 tools/uv_deps.py "${_args[@]}" 2>/dev/null)

  if [[ ${#_deps[@]} -gt 0 ]] \
     && uv pip install --python .venv/bin/python "${_deps[@]}" >/dev/null; then
    touch "$_stamp"
  else
    log_status "依赖同步失败，请手动运行：uv pip install --python .venv/bin/python \$(python3 tools/uv_deps.py --exclude slimeface)"
  fi
fi

VIRTUAL_ENV="$PWD/.venv"
export VIRTUAL_ENV
PATH_add "$VIRTUAL_ENV/bin"

# javsp/ 与 javsp/web/ 没有 __init__.py（PEP-420 命名空间包），
# 因此从源码运行时需要把仓库根目录加入 PYTHONPATH。
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"
